#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "optparse"
require "raptor/simulation"

options = {
  inputs: [],
  output: ENV.fetch("RAPTOR_BENCH_SITE", "tmp/raptor-benchmarks/site"),
  title: "Raptor Benchmarks"
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: raptor-benchmark-site [options]"

  opts.on("--input DIR", "Benchmark output root; repeatable") { |value| options[:inputs] << value }
  opts.on("--output DIR", "Static site output directory") { |value| options[:output] = value }
  opts.on("--title TITLE", "Site title") { |value| options[:title] = value }
  opts.on("-h", "--help", "Print help") do
    puts opts
    exit
  end
end

parser.parse!(ARGV)
options[:inputs] = ["tmp/raptor-benchmarks/runs"] if options[:inputs].empty?

result = Raptor::Simulation::BenchmarkSite.build(
  input_roots: options.fetch(:inputs),
  output_dir: options.fetch(:output),
  title: options.fetch(:title)
)

puts "indexed runs: #{result.fetch("runs")}"
puts "site index: #{result.fetch("index")}"
